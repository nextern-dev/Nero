# ── Required ──────────────────────────────────────────────
# Postgres connection string (Neon works great: postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nero

# Auth.js session secret — generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# ── Optional: transactional email via Resend ──────────────
# Without a key, emails are logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Nero <onboarding@resend.dev>"

# ── Optional: "Continue with Google" ──────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Authorized redirect URI: <your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Optional: absolute base URL (OG images, emails) ───────
NEXT_PUBLIC_APP_URL=http://localhost:3000
